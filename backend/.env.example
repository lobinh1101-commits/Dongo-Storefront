NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=0
COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
DATABASE_PATH=data/storefront.sqlite
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dongo_storefront
DB_USER=dongo_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Register for VNPay sandbox credentials at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Set both callback URLs to a publicly reachable HTTPS backend before testing VNPay.
VNPAY_RETURN_URL=https://YOUR_PUBLIC_HOST/api/payments/vnpay/return
VNPAY_IPN_URL=https://YOUR_PUBLIC_HOST/api/payments/vnpay/ipn
